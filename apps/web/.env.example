# Server-only -- never exposed to the browser (no NEXT_PUBLIC_ prefix). Must
# match the backend's own APP_SHARED_TOKEN (see ../../.env.example) exactly:
# this value is both the password checked at /login and the Bearer token
# attached when this app calls the backend on the browser's behalf.
APP_SHARED_TOKEN=dev-token-change-me

# Base URL of the FastAPI backend, reachable from wherever THIS app runs --
# http://localhost:8000 for local (non-Docker) `npm run dev`, http://api:8000
# when both run inside docker-compose (see the `api` service's own hostname).
API_BASE_URL=http://localhost:8000
