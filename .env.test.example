# Template for .env.test -- the DEDICATED database for running the backend test suite
# (tests/unit, tests/integration). This must point at a DIFFERENT database than .env's own
# DATABASE_URL -- tests/integration's fixtures create synthetic seasons/players and mutate the
# GLOBAL seasons.is_current flag; running them against the real dev database corrupts whatever
# real data is currently loaded (confirmed: it happened once, a test run flipped is_current onto
# a synthetic season and the live UI started showing "Player1"/"Player2" instead of real names).
#
# Setup (one-time per machine/checkout):
#   docker exec fpl-decision-engine-postgres-1 psql -U fpl -d postgres -c "CREATE DATABASE fpl_decision_engine_test;"
#   DATABASE_URL=postgresql+psycopg://fpl:changeme@localhost:5432/fpl_decision_engine_test uv run alembic upgrade head
#
# Always run tests via: `set -a; source .env.test; set +a` before `uv run pytest ...` --
# never `.env` (that one is for the real dev database / docker-compose stack only).

POSTGRES_USER=fpl
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fpl_decision_engine_test

DATABASE_URL=postgresql+psycopg://fpl:changeme@localhost:5432/fpl_decision_engine_test

APPLICATION_SECRET_KEY=dev-secret-change-me
LOG_LEVEL=INFO
ENVIRONMENT=development

APP_SHARED_TOKEN=dev-token-change-me
CORS_ALLOWED_ORIGINS=http://localhost:3000

FPL_MANAGER_ID=4923902
FPL_H2H_LEAGUE_ID=759345
