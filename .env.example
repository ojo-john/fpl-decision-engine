# Postgres connection settings used by docker-compose.yml
POSTGRES_USER=fpl
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fpl_decision_engine

# Full SQLAlchemy connection string used by the app directly (e.g. via `make run`).
# NOTE: when running through Docker Compose, the `api` service overrides this
# value to use `@postgres:5432` (the compose network hostname) instead of
# `@localhost:5432` — see the `environment.DATABASE_URL` override in
# docker-compose.yml. Use `@localhost:5432` here for local (non-Docker) runs.
DATABASE_URL=postgresql+psycopg://fpl:changeme@localhost:5432/fpl_decision_engine

APPLICATION_SECRET_KEY=dev-secret-change-me
LOG_LEVEL=INFO
ENVIRONMENT=development

# FPL_MANAGER_ID and FPL_H2H_LEAGUE_ID are public numeric identifiers (your FPL
# manager ID and H2H league ID), NOT secrets. They are unused until a later
# milestone wires up FPL API ingestion. When that milestone lands, prefer
# setting them as GitHub Actions *variables* (not secrets) in CI/CD.
# FPL_MANAGER_ID=
# FPL_H2H_LEAGUE_ID=
