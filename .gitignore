# Environment
.env

# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS
.DS_Store

# Claude Code local tooling state (worktrees created for parallel subagents, local settings)
.claude/

# Frontend
node_modules/
dist/
build/
.next/
apps/web/.env.local
apps/web/tsconfig.tsbuildinfo
apps/web/test-results/
apps/web/playwright-report/

# Generated OpenAPI schema dump -- transient input to `npm run generate-api-types`
# (see apps/web/package.json); the generated apps/web/lib/api-types.ts IS committed.
/openapi.json

# Logs
*.log

# Local Postgres data
pgdata/
postgres-data/

# Generated local ingestion reports (durable copy lives in the DB / CI artifacts)
reports/*
!reports/.gitkeep
!reports/ingestion/
reports/ingestion/*
!reports/ingestion/.gitkeep

# Generated ML model artifacts (Milestone 3 Layer 3+, e.g. .joblib files) -
# durable copies are re-trainable from ingested data, not meant to be committed
models/*
!models/.gitkeep

# SQLite (should not be used, but ignore stray files)
*.sqlite3
